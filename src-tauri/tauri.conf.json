{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focusite Launcher",
  "version": "26.1.0",
  "identifier": "com.focusite.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Focusite Launcher",
        "url": "splash.html",
        "width": 480,
        "height": 320,
        "center": true,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "backgroundColor": "#0b0f17",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      },
      {
        "label": "main",
        "title": "Focusite Launcher",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0a0f1d",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: wss:; font-src 'self' data:; media-src 'self' asset: http://asset.localhost data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/focusite_launcher/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2OEVGOUVGMTcwQzU5RDcKUldSZm1nUGY4M3hUaWdOUk9Oa0lQd3FkOG8wL3pLM0hSOW1rSW9vVnZ5OD0K",
      "endpoints": [
        "https://github.com/focusite/focusite-launcher/releases/latest/download/latest.json"
      ]
    }
  }
}